.head {
  padding: 48rpx 32rpx 40rpx;
  background: linear-gradient(180deg, #F6E9DC 0%, #FBF7F0 100%);
}
.head-name { font-size: 42rpx; font-weight: 700; color: #7A2E1C; letter-spacing: 2rpx; }
.head-sub { font-size: 25rpx; color: #A9734F; margin-top: 6rpx; }

.block { margin: 20rpx 24rpx; }

.row-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 84rpx;
  border-bottom: 1rpx solid #F5EDE2;
  font-size: 27rpx;
}
.row-k { color: #8C8279; }
.row-v { color: #2C2723; }
.hint { font-size: 21rpx; color: #B8AFA4; margin-top: 14rpx; }
.btns { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btns .btn { flex: 1; }

.p { font-size: 25rpx; color: #5A5249; line-height: 1.9; margin-top: 10rpx; }

.openid {
  word-break: break-all;
  font-family: monospace;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6B6259;
  background: #FBF7F0;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
}

.foot {
  text-align: center;
  font-size: 21rpx;
  color: #C4BBB0;
  padding: 40rpx 0 60rpx;
}

/* 本地联调身份提示：虚线框，发布前清掉 devOpenid 就自动消失 */
.devtip {
  margin: 24rpx 0 0;
  padding: 18rpx 22rpx;
  border: 2rpx dashed #D9B9AC;
  border-radius: 12rpx;
  background: #FDF4EF;
  font-size: 22rpx;
  color: #8C5A46;
}
.devtip-sub { display: block; margin-top: 6rpx; font-size: 20rpx; color: #B08A78; }
