<view class="page">

  <view class="head">
    <view class="head-name">{{s.shopName || '老家特产'}}</view>
    <view class="head-sub">{{s.slogan || '老家直发 · 熟人小单'}}</view>
  </view>

  <!-- 管理员 -->
  <view class="card block" wx:if="{{isAdmin}}">
    <view class="h2">卖家后台</view>
    <view class="t-sub" style="margin:6rpx 0 20rpx;">只有你能看到这个入口：登记单、商品、店铺设置</view>
    <button class="btn btn-pri" bindtap="goAdmin">进入卖家工具</button>
  </view>

  <!-- 初始化 -->
  <view class="card block" wx:if="{{needInit}}">
    <view class="h2">还没初始化</view>
    <view class="t-sub" style="margin:6rpx 0 20rpx;">点下面按钮创建数据库并写入几条示例</view>
    <button class="btn btn-pri" bindtap="initShop">初始化店铺数据</button>
  </view>

  <!-- 说明 -->
  <view class="card block">
    <view class="h2">这个小程序做什么</view>
    <view class="p">只做三件事：陈列我老家有哪些特产、让你登记你想要什么、把这份登记给我。</view>
    <view class="p">这里不收钱、也没有线上支付。你提交登记后，我给你打电话确认运费和总额，转账在微信里直接给我，我再寄出或者你自取。</view>
    <view class="p">有任何问题直接微信找我，比在小程序里点来点去快。</view>
  </view>

  <!-- 我的 ID：给店主开通管理权限用，管理员自己不显示 -->
  <view class="card block" wx:if="{{!isAdmin && openid}}">
    <view class="h2">我的 ID</view>
    <view class="t-sub" style="margin:6rpx 0 12rpx;">点一下复制，发给店主，他用来给你开通管理权限</view>
    <view class="openid" bindtap="copyOpenid">{{openid}}</view>
  </view>

  <!-- 本地联调身份提示，只在 config.js 填了 devOpenid 时出现 -->
  <view class="devtip" wx:if="{{devWho}}">
    本地测试身份：{{devWho}}
    <text class="devtip-sub">改 config.js 里的 devOpenid 重新编译，就能换成另一个人的身份</text>
  </view>
</view>
