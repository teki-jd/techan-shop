.tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EEE5D9;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0 22rpx;
  font-size: 28rpx;
  color: #8C8279;
  position: relative;
}
.tab.on { color: #B4472E; font-weight: 600; }
.tab.on::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 6rpx;
  width: 44rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: #B4472E;
}
.badge {
  display: inline-block;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  margin-left: 6rpx;
  border-radius: 14rpx;
  background: #B4472E;
  color: #FFF;
  font-size: 19rpx;
  vertical-align: 4rpx;
}

.filters {
  white-space: nowrap;
  padding: 18rpx 24rpx;
  display: flex;
}
.chip {
  display: inline-block;
  flex: none;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #F0E6D9;
  font-size: 24rpx;
  color: #6B6259;
}
.chip.on { background: #2C2723; color: #FFFFFF; border-color: #2C2723; }
.chip .c { margin-left: 6rpx; color: #E0A88F; font-size: 20rpx; }

.order { margin: 0 24rpx 20rpx; }

.o-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #F5EDE2;
}
.o-no { font-size: 23rpx; color: #8C8279; letter-spacing: 1rpx; }
.o-status { font-size: 21rpx; border: 1rpx solid; border-radius: 20rpx; padding: 2rpx 12rpx; }

.buyer { padding: 16rpx 0; }
.buyer-name { font-size: 30rpx; font-weight: 600; }
.mode-tag {
  font-size: 20rpx;
  color: #C08A47;
  background: #FBF1E2;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
  font-weight: 400;
}
.buyer-line { font-size: 25rpx; color: #6B6259; margin-top: 6rpx; }
.buyer-line .link { color: #B4472E; }
.buyer-line .addr { color: #2C2723; }

.o-items { padding: 8rpx 0 12rpx; border-top: 1rpx dashed #F0E6D9; }
.o-item {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 6rpx 0;
}
.o-it-name { color: #2C2723; }
.o-it-qty { color: #8C8279; font-size: 23rpx; }

.o-money {
  font-size: 25rpx;
  color: #5A5249;
  background: #FBF7F0;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}
.o-money .total { color: #B4472E; font-weight: 600; margin-left: 6rpx; }

.o-remark, .o-adminnote {
  margin-top: 10rpx;
  font-size: 23rpx;
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
}
.o-remark { color: #6B6259; background: #F7F2EA; }
.o-adminnote { color: #7A2E1C; background: #FDF1EC; }

.o-time { font-size: 21rpx; color: #B8AFA4; margin-top: 12rpx; }

.o-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 18rpx; flex-wrap: wrap; }
.o-extra {
  text-align: right;
  font-size: 22rpx;
  color: #B0A79C;
  margin-top: 14rpx;
  text-decoration: underline;
}

.add-bar { padding: 20rpx 24rpx 8rpx; }

.prow {
  display: flex;
  gap: 20rpx;
  margin: 0 24rpx 18rpx;
  padding: 20rpx;
}
.pthumb { width: 140rpx; height: 140rpx; border-radius: 12rpx; flex: none; background: #F4E9DA; }
.pmain { flex: 1; min-width: 0; }
.pname { font-size: 29rpx; font-weight: 600; }
.pmeta { font-size: 22rpx; color: #8C8279; margin-top: 6rpx; }
.prow-btns {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.switch-wrap { display: flex; align-items: center; gap: 8rpx; }
.switch-label { font-size: 22rpx; color: #8C8279; }

.block { margin: 20rpx 24rpx; }
.notice-area {
  width: 100%;
  height: 180rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  background: #FBF7F0;
  border-radius: 12rpx;
  padding: 18rpx;
}
.save-bar { padding: 8rpx 24rpx 20rpx; }
.p { font-size: 23rpx; color: #6B6259; line-height: 1.8; margin-top: 10rpx; }

/* 分类管理 */
.cat-card { margin-bottom: 16rpx; }
.cat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48rpx;
}
.cat-head-l { display: flex; align-items: baseline; gap: 12rpx; }
.cat-count { font-size: 22rpx; color: #A9A096; }
.cat-toggle { font-size: 23rpx; color: #B4472E; }
.cat-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.cat-input { flex: 1; }

/* 商品搜索 */
.search-bar {
  display: flex;
  align-items: center;
  margin: 0 24rpx 4rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #F0E6D9;
  border-radius: 28rpx;
}
.search-input { flex: 1; height: 74rpx; font-size: 26rpx; }
.search-clear { font-size: 23rpx; color: #B4472E; padding-left: 16rpx; }

/* 商品分组 */
.list-sum { padding: 2rpx 28rpx 8rpx; font-size: 21rpx; color: #B0A79C; }
.pgroup { margin-bottom: 4rpx; }
.pgroup-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 28rpx 10rpx;
}
.pgroup-name { font-size: 24rpx; color: #6B6259; font-weight: 600; }
.pgroup-count { font-size: 20rpx; color: #A9A096; }
.pedit { font-size: 22rpx; color: #B4472E; }
