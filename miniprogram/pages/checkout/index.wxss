.block { margin: 20rpx 24rpx; }

/* 清单卡片顶部：返回箭头贴左上角，标题居中 */
.card-head {
  display: flex;
  align-items: center;
  padding-bottom: 6rpx;
  border-bottom: 1rpx solid #F5EDE2;
  margin-bottom: 4rpx;
}
.card-head .back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  flex: none;
}
.card-head .back::before {
  content: '';
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #7A2E1C;
  border-bottom: 4rpx solid #7A2E1C;
  transform: rotate(45deg);
  margin-left: 6rpx;
}
.card-head .back:active::before { border-color: #B4472E; }
.card-head .card-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #7A2E1C;
  letter-spacing: 2rpx;
}
.card-head .head-hold { width: 64rpx; flex: none; }

.item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5EDE2;
  position: relative;
}
.item:last-of-type { border-bottom: none; }
.thumb { width: 140rpx; height: 140rpx; border-radius: 12rpx; flex: none; background: #F4E9DA; }
.item-main { flex: 1; min-width: 0; }
.item-name { font-size: 29rpx; font-weight: 600; padding-right: 70rpx; }
.item-unit { font-size: 23rpx; color: #8C8279; margin-top: 4rpx; }
.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.item-line { color: #B4472E; font-size: 28rpx; font-weight: 600; }
.del {
  position: absolute;
  right: 0;
  top: 20rpx;
  font-size: 22rpx;
  color: #B0A79C;
}

.qty {
  display: flex;
  align-items: center;
  border: 1rpx solid #EEE5D9;
  border-radius: 10rpx;
  overflow: hidden;
}
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 32rpx;
  color: #6B6259;
  background: #FAF6F0;
}
.qty-num { width: 66rpx; text-align: center; font-size: 26rpx; }

.sum {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-top: 22rpx;
}
.sum-num { font-size: 40rpx; }
.sum-tip { text-align: right; font-size: 22rpx; color: #B8AFA4; margin-top: 6rpx; }

.modes { display: flex; gap: 20rpx; }
.mode {
  flex: 1;
  border: 1rpx solid #EEE5D9;
  border-radius: 16rpx;
  padding: 20rpx;
  background: #FFFDFB;
}
.mode.on { border-color: #B4472E; background: #FDF4F0; }
.mode-t { font-size: 27rpx; font-weight: 600; color: #2C2723; }
.mode.on .mode-t { color: #B4472E; }
.mode-s { font-size: 22rpx; color: #8C8279; margin-top: 6rpx; line-height: 1.5; }

.addr-import {
  text-align: right;
  font-size: 22rpx;
  color: #B4472E;
  padding: 12rpx 0 0;
}

.note-t { font-size: 26rpx; font-weight: 600; color: #7A2E1C; }
.note-c { font-size: 24rpx; color: #6B6259; line-height: 1.8; margin-top: 10rpx; }

.bar-left { flex: none; }
.bar-total { display: flex; align-items: baseline; gap: 8rpx; }
.bar-num { font-size: 38rpx; }
.bar-sub { font-size: 20rpx; color: #B8AFA4; }
