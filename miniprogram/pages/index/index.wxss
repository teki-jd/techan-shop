/* 置顶公告：单行，超出省略，点一下弹全文 */
.notice-bar {
  display: flex;
  align-items: center;
  padding: 14rpx 32rpx;
  background: #F3E3D4;
  font-size: 23rpx;
  color: #6B6259;
  line-height: 1.35;
}
.nb-dot { flex: none; color: #B4472E; font-weight: 700; margin-right: 10rpx; }
.nb-txt {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero {
  padding: 28rpx 32rpx 24rpx;
  background: linear-gradient(180deg, #F6E9DC 0%, #FBF7F0 100%);
}
.hero-name { font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; color: #7A2E1C; }
.hero-slogan { color: #A9734F; font-size: 26rpx; margin-top: 6rpx; }

.init { margin: 0 24rpx 24rpx; }

.cats {
  white-space: nowrap;
  padding: 8rpx 24rpx 16rpx;
  display: flex;
}
.cat {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #6B6259;
  font-size: 26rpx;
  border: 1rpx solid #F0E6D9;
  flex: none;
}
.cat.on {
  background: #B4472E;
  color: #FFFFFF;
  border-color: #B4472E;
  font-weight: 600;
}

.list { padding: 0 24rpx; }
.row {
  display: flex;
  gap: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex: none;
  background: #F4E9DA;
}
.row-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.row-name { font-size: 31rpx; font-weight: 600; }
.row-desc {
  font-size: 23rpx;
  color: #8C8279;
  margin-top: 6rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.row-tags { margin-top: 10rpx; }
.row-tags .mini {
  display: inline-block;
  font-size: 20rpx;
  color: #C08A47;
  background: #FBF1E2;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
}
.row-bottom {
  margin-top: auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.row-price .t-price { font-size: 36rpx; }
.row-price .unit { color: #A9A096; font-size: 22rpx; }
.add {
  font-size: 24rpx;
  color: #B4472E;
  border: 1rpx solid #E0C3B8;
  border-radius: 30rpx;
  padding: 8rpx 22rpx;
  background: #FFFDFB;
}

.err { margin: 24rpx; }

.cartbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #2C2723;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx 0 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(44, 39, 35, 0.28);
  z-index: 30;
}
.cartbar-l { display: flex; align-items: baseline; gap: 10rpx; }
.cartbar-num { color: #FFD9A8; font-size: 34rpx; font-weight: 700; }
.cartbar-txt { color: #E8DFD4; font-size: 24rpx; }
.cartbar-btn {
  background: #B4472E;
  color: #FFFFFF;
  font-size: 27rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border-radius: 36rpx;
}

.admin-entry {
  margin: 32rpx 24rpx 0;
  text-align: center;
  color: #8C8279;
  font-size: 24rpx;
  text-decoration: underline;
}

.foot {
  text-align: center;
  color: #B8AFA4;
  font-size: 22rpx;
  padding: 40rpx 40rpx 60rpx;
}
