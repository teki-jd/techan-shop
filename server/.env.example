# 复制成 .env 再改（.env 不要提交到 git、不要发群里）
# 对外域名：mjd-tcd.tearth.cn（填在 nginx 里，不是这个文件的变量）
# 端口：本机测试用 3000，线上由 nginx 转到 443，这个端口不用对外开放
PORT=3000
HOST=127.0.0.1

# 小程序后台 → 开发管理 → 开发设置 里拿
APPID=wx0000000000000000
APPSECRET=填写你的AppSecret不要外泄

# 自己随便生成一串长随机字符，用来签登录 token
# 生成命令： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=换成一串随机字符

# 数据文件位置（默认 server/data/db.json）
# DATA_FILE=/var/www/techan-server/data/db.json

# 只有本地测试才设 1。线上必须是 0 或删掉这一行！
DEV_MODE=0
